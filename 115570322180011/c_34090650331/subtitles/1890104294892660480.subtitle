{"body":[{"from":0.354,"to":1.9340000000000002,"location":0,"content":"大家好，我是Nikola。"},{"from":2.4939999999999998,"to":4.8149999999999995,"location":0,"content":"在本视频中，我们将讨论虚拟内存。"},{"from":5.335,"to":6.675,"location":0,"content":"我会带大家了解相关的问题，"},{"from":7.115,"to":10.256,"location":0,"content":"虚拟内存是如何解决这些问题的，以及它是如何实现的。"},{"from":11.696,"to":14.217,"location":0,"content":"我们将看看虚拟内存解决的三个问题。"},{"from":14.877,"to":17.397,"location":0,"content":"内存不足、内存碎片化，"},{"from":17.777,"to":18.458,"location":0,"content":"以及安全性。"},{"from":19.478,"to":22.098,"location":0,"content":"在过去，计算机内存非常昂贵，"},{"from":22.238,"to":24.439,"location":0,"content":"而且计算机的内存远没有现在多。"},{"from":24.939,"to":28.58,"location":0,"content":"例如，大多数CPU最多只能支持4GB内存，"},{"from":28.8,"to":31.62,"location":0,"content":"但当时的电脑通常只有1GB内存，"},{"from":31.861,"to":32.381,"location":0,"content":"甚至更少。"},{"from":33.121,"to":35.482,"location":0,"content":"为什么CPU只能支持最多4GB内存？"},{"from":35.642,"to":38.683,"location":0,"content":"这是因为寄存器只能存储32位数据，"},{"from":38.863,"to":42.085,"location":0,"content":"最多只能访问2的32次方字节的内存，"},{"from":42.285,"to":45.666,"location":0,"content":"也就是4GB，理论上每个程序都可以做到这一点。"},{"from":46.867,"to":49.988,"location":0,"content":"而现代CPU则拥有64位的地址空间，"},{"from":50.368,"to":52.689,"location":0,"content":"但在本视频中我们将以32位为例，"},{"from":52.909,"to":54.53,"location":0,"content":"因为这样数字更容易理解。"},{"from":55.93,"to":58.671,"location":0,"content":"在这个例子中，我们的电脑只有2GB的内存，"},{"from":58.931,"to":64.072,"location":0,"content":"也就是31位地址空间。那么当程序尝试访问前几个字节时会发生什么？"},{"from":64.953,"to":65.693,"location":0,"content":"这没有问题。"},{"from":66.533,"to":69.734,"location":0,"content":"但如果程序尝试使用超过2GB的内存会怎样？"},{"from":70.514,"to":73.095,"location":0,"content":"程序会崩溃，因为没有可用的内存可以访问。"},{"from":73.715,"to":76.455,"location":0,"content":"这就是为什么在上世纪五十年代左右，程序经常崩溃的原因。"},{"from":77.695,"to":79.076,"location":0,"content":"现在我们来看第二个问题。"},{"from":79.856,"to":83.257,"location":0,"content":"假设我们安装了4GB内存，并且有三个程序。"},{"from":83.837,"to":87.077,"location":0,"content":"一个播放电影的视频播放器，需要1GB内存。"},{"from":87.717,"to":90.238,"location":0,"content":"一个需要2GB内存的视频游戏。"},{"from":90.366,"to":93.227,"location":0,"content":"还有一个同样需要2GB内存的照片编辑软件。"},{"from":94.267,"to":97.347,"location":0,"content":"如果我们运行程序1和程序2，它们可以装进内存。"},{"from":97.687,"to":99.968,"location":0,"content":"它们共占用3GB，还剩下1GB空闲。"},{"from":100.908,"to":107.089,"location":0,"content":"如果我们关闭视频播放器，现在只占用2GB内存，还有2GB空闲空间。"},{"from":107.749,"to":110.09,"location":0,"content":"我们本应该可以运行照片编辑软件，"},{"from":110.45,"to":111.99,"location":0,"content":"但实际上无法运行，因为内存被分割了，"},{"from":112.37,"to":113.911,"location":0,"content":"即使总空间是足够的。"},{"from":115.171,"to":116.791,"location":0,"content":"这就是所谓的内存碎片。"},{"from":118.152,"to":120.852,"location":0,"content":"你可能会问，为什么不能把程序分散到不同的内存区域？"},{"from":121.773,"to":124.634,"location":0,"content":"其实可以，但编写这样的程序会非常困难。"},{"from":125.374,"to":127.195,"location":0,"content":"如果我们有一个全局数组，"},{"from":127.575,"to":131.937,"location":0,"content":"如果数组被分成两个内存块，我们就无法通过索引访问任意元素，"},{"from":131.957,"to":132.477,"location":0,"content":"比如说。"},{"from":133.597,"to":136.078,"location":0,"content":"我们就必须实现某种间接访问机制，"},{"from":136.377,"to":139.06,"location":0,"content":"正如你之后会看到的，这就是虚拟内存的作用。"},{"from":140.56,"to":141.841,"location":0,"content":"我们来看看第三个问题。"},{"from":142.641,"to":145.862,"location":0,"content":"我们之前说过，每个程序都可以访问任意32位地址，"},{"from":146.302,"to":149.244,"location":0,"content":"那么如果两个程序试图访问同一块内存，会发生什么呢？"},{"from":149.244,"to":154.306,"location":0,"content":"比如说，两个程序都向地址64写入某个值，"},{"from":154.306,"to":156.526,"location":0,"content":"一个是存储玩家当前生命值的电子游戏，"},{"from":156.927,"to":159.308,"location":0,"content":"另一个是写入剩余歌曲时长的音乐播放器。"},{"from":159.868,"to":163.289,"location":0,"content":"当歌曲播放结束时，音乐播放器会把0写入这个地址，"},{"from":163.669,"to":165.57,"location":0,"content":"如果这也是玩家的生命值，"},{"from":165.65,"to":167.371,"location":0,"content":"你就会“死亡”，游戏也就结束了。"},{"from":167.811,"to":171.412,"location":0,"content":"这会非常糟糕，因为这两个程序正在破坏彼此的数据状态。"},{"from":172.473,"to":176.554,"location":0,"content":"所以总结一下，如果所有程序都能访问同一个32位内存空间，"},{"from":176.855,"to":181.736,"location":0,"content":"如果访问了无效的内存地址（因为电脑内存小于4GB），程序可能会崩溃。"},{"from":182.276,"to":186.537,"location":0,"content":"如果有多个程序同时运行，由于内存碎片化，它们也可能会耗尽空间，"},{"from":187.637,"to":189.318,"location":0,"content":"或者它们还可能相互破坏对方的数据。"},{"from":190.638,"to":194.299,"location":0,"content":"这里的关键问题是，多个程序可以访问同一个内存空间。"},{"from":194.919,"to":197.72,"location":0,"content":"所以，如果我们能为每个程序分配独立的内存空间，"},{"from":198.2,"to":200.06,"location":0,"content":"那么这些问题或许就能得到解决。"},{"from":201.06,"to":204.281,"location":0,"content":"分配给每个程序的内存空间被称为虚拟内存，"},{"from":204.581,"to":210.142,"location":0,"content":"每个程序都有自己的虚拟内存，与其他程序互不重叠。"},{"from":210.27,"to":213.871,"location":0,"content":"这意味着我们需要将每个程序的虚拟内存空间映射到RAM空间。"},{"from":214.691,"to":219.712,"location":0,"content":"我们将RAM称为物理内存，RAM的地址称为物理地址。"},{"from":220.372,"to":223.993,"location":0,"content":"我们使用“物理内存”和“物理地址”这两个术语，而不是“RAM内存”，"},{"from":224.133,"to":228.094,"location":0,"content":"和“地址”，因为CPU能访问的物理内存设备不只有RAM。"},{"from":229.034,"to":233.835,"location":0,"content":"它还可以访问映射到同一地址空间的其他设备的内存或寄存器。"},{"from":234.655,"to":240.536,"location":0,"content":"当计算机启动时，安装的RAM会从某个物理内存地址开始被操作系统使用。"},{"from":241.236,"to":243.677,"location":0,"content":"操作系统还会为自身保留一部分RAM，"},{"from":243.938,"to":245.958,"location":0,"content":"剩下的部分则用于程序运行。"},{"from":246.398,"to":248.559,"location":0,"content":"不过我有点偏离了主题。"},{"from":249.22,"to":252.641,"location":0,"content":"RAM是理解虚拟内存工作原理时最重要的设备，"},{"from":253.041,"to":255.862,"location":0,"content":"所以在本视频中，当我提到物理地址或物理内存时，"},{"from":256.182,"to":257.043,"location":0,"content":"你可以理解为RAM。"},{"from":259.084,"to":261.704,"location":0,"content":"让我们看看虚拟内存是如何解决这些问题的。"},{"from":262.524,"to":266.827,"location":0,"content":"没有虚拟内存时，每个程序都可以访问32位地址空间，"},{"from":267.187,"to":268.901,"location":0,"content":"这些地址空间会直接映射到物理内存（RAM）。"},{"from":268.901,"to":273.349,"location":0,"content":"而有了虚拟内存后，每个程序仍然拥有32位地址空间，"},{"from":273.769,"to":275.69,"location":0,"content":"但现在中间多了一个映射关系。"},{"from":276.39,"to":280.052,"location":0,"content":"这个映射表知道如何把虚拟地址转换为物理地址。"},{"from":280.672,"to":282.793,"location":0,"content":"如果一个程序想访问地址0，"},{"from":282.793,"to":286.515,"location":0,"content":"比如，我们查一下映射表，发现它对应的是"},{"from":286.595,"to":288.075,"location":0,"content":"比如物理地址5。"},{"from":288.075,"to":291.316,"location":0,"content":"任何虚拟地址都可以映射到任意物理地址。"},{"from":292.357,"to":296.819,"location":0,"content":"但如果程序要访问的数据超过了内存容量，会发生什么呢？"},{"from":297.419,"to":298.817,"location":0,"content":"这些数据可以存储在其他地方，"},{"from":298.817,"to":302.041,"location":0,"content":"映射表会告诉我们，这些数据不在内存里，"},{"from":302.261,"to":303.901,"location":0,"content":"比如说，它在硬盘上。"},{"from":304.602,"to":306.663,"location":0,"content":"操作系统会找到最旧的数据，"},{"from":307.043,"to":309.604,"location":0,"content":"比如这里的地址0，把它移到硬盘上，"},{"from":310.144,"to":312.445,"location":0,"content":"然后把要访问的地址3加载到内存里。"},{"from":312.445,"to":314.086,"location":0,"content":"同时会更新映射关系。"},{"from":315.386,"to":318.047,"location":0,"content":"这样程序就可以读取地址3了。"},{"from":318.047,"to":321.829,"location":0,"content":"映射机制让我们可以在需要时用硬盘来扩展内存。"},{"from":322.469,"to":324.97,"location":0,"content":"这种额外的内存叫做交换内存。"},{"from":326.03,"to":330.032,"location":0,"content":"当数据不在内存里，操作系统需要从硬盘读取时，"},{"from":330.232,"to":331.613,"location":0,"content":"我们称之为“缺页异常”。"},{"from":332.173,"to":333.853,"location":0,"content":"我们稍后会详细讲缺页异常。"},{"from":335.294,"to":338.635,"location":0,"content":"不过，这并不是完美的方案，因为从硬盘读取数据到内存，"},{"from":338.856,"to":340.556,"location":0,"content":"以及更新映射关系的速度都很慢。"},{"from":341.397,"to":345.158,"location":0,"content":"即使是固态硬盘，读取第一个字节的延迟也可能比内存慢1000倍，"},{"from":345.678,"to":347.959,"location":0,"content":"但大多数情况下，这总比程序崩溃要好。"},{"from":348.98,"to":352.241,"location":0,"content":"这也是为什么增加内存可以大幅提升电脑性能，"},{"from":352.801,"to":355.962,"location":0,"content":"尤其是在频繁进行内存和硬盘数据交换时。"},{"from":357.483,"to":359.984,"location":0,"content":"现在我们来看看虚拟内存是如何解决碎片化问题的。"},{"from":359.984,"to":360.264,"location":0,"content":"碎片化问题。"},{"from":360.984,"to":363.885,"location":0,"content":"还记得我们之前的例子吗？我们关闭了视频播放器，"},{"from":364.125,"to":368.286,"location":0,"content":"并且想在保持游戏运行的同时启动照片编辑软件。"},{"from":369.206,"to":371.426,"location":0,"content":"我们剩下了2GB的空闲内存，"},{"from":371.946,"to":374.307,"location":0,"content":"但这些空间被分成了两个1GB的块。"},{"from":375.547,"to":379.308,"location":0,"content":"我们无法运行新程序，因为它无法放入连续的地址空间。"},{"from":380.128,"to":384.269,"location":0,"content":"有了虚拟内存，我们可以把程序的不同部分映射到每个可用的内存块中。"},{"from":385.029,"to":387.449,"location":0,"content":"从程序的角度来看，一切都没有变化，"},{"from":387.589,"to":389.95,"location":0,"content":"它仍然认为内存是连续的。"},{"from":391.326,"to":392.926,"location":0,"content":"现在我们来谈谈安全性问题。"},{"from":393.827,"to":396.127,"location":0,"content":"虚拟内存是如何保证程序安全的呢？"},{"from":396.927,"to":400.108,"location":0,"content":"我们回到之前的视频游戏和音乐播放器的例子。"},{"from":400.928,"to":403.829,"location":0,"content":"两个程序都有各自的虚拟地址空间和映射表。"},{"from":404.609,"to":408.469,"location":0,"content":"当视频游戏在地址64访问玩家的生命值时，"},{"from":408.469,"to":411.77,"location":0,"content":"它可能被映射到物理地址10。"},{"from":411.77,"to":414.231,"location":0,"content":"而当音乐播放器写入剩余的歌曲时长时，"},{"from":414.651,"to":417.131,"location":0,"content":"它可能写入物理地址4。"},{"from":417.131,"to":419.682,"location":0,"content":"即使每个程序都试图写入地址64，"},{"from":419.682,"to":422.152,"location":0,"content":"它们实际上被映射到不同的物理位置。"},{"from":423.173,"to":425.414,"location":0,"content":"但完全隔离也不是最好的，"},{"from":425.514,"to":427.775,"location":0,"content":"因为这样程序之间无法共享任何数据。"},{"from":428.435,"to":433.097,"location":0,"content":"幸运的是，这很容易解决，只需让每个程序的部分内容映射到同一个物理空间即可。"},{"from":434.017,"to":437.459,"location":0,"content":"比如，每个程序可能都需要读取同一个共享库，"},{"from":437.779,"to":445.742,"location":0,"content":"比如Win32 API或libc，或者它们可以使用RAM中的共享内存空间来交换数据，而无需通过其他设备，"},{"from":445.802,"to":448.083,"location":0,"content":"比如磁盘或网络接口等。"},{"from":450.584,"to":453.644,"location":0,"content":"现在让我们来看一下虚拟内存是如何实现的。"},{"from":454.325,"to":456.505,"location":0,"content":"当一个程序访问内存时，会发生什么？"},{"from":457.205,"to":461.746,"location":0,"content":"假设一个程序想要从地址64加载数据到寄存器R1。"},{"from":462.726,"to":464.687,"location":0,"content":"当CPU执行这条指令时，"},{"from":465.227,"to":469.388,"location":0,"content":"首先它需要找到虚拟地址64到物理地址的映射，"},{"from":469.948,"to":472.088,"location":0,"content":"然后从物理地址读取数据。"},{"from":472.788,"to":476.989,"location":0,"content":"这种映射被称为页表，每一个映射称为页表项。"},{"from":477.749,"to":481.15,"location":0,"content":"在我们的例子中，每个虚拟地址都有一个对应的页表项。"},{"from":481.514,"to":485.275,"location":0,"content":"实际上，CPU是以字为单位工作的，字的大小等于CPU寄存器的大小。"},{"from":486.015,"to":488.995,"location":0,"content":"在我们的例子中，一个字是32位，也就是4字节。"},{"from":489.236,"to":493.716,"location":0,"content":"所以从技术上讲，页表为虚拟地址空间中的每一个字都分配了一个条目。"},{"from":494.697,"to":497.397,"location":0,"content":"那么我们需要多少空间来存储每个字的映射呢？"},{"from":498.277,"to":500.478,"location":0,"content":"一共有2的32次方个地址，"},{"from":500.798,"to":502.358,"location":0,"content":"每个地址对应一个字节，"},{"from":502.578,"to":504.499,"location":0,"content":"这意味着有2的30次方个字。"},{"from":505.439,"to":507.079,"location":0,"content":"这大约是十亿个条目。"},{"from":507.899,"to":510.032,"location":0,"content":"每个条目存储一个物理地址，"},{"from":510.032,"to":514.321,"location":0,"content":"也是32位，所以一个页表的大小将是4GB。"},{"from":515.041,"to":517.221,"location":0,"content":"而且每个程序都有一个页表。"},{"from":517.741,"to":518.741,"location":0,"content":"这显然非常庞大。"},{"from":519.442,"to":520.082,"location":0,"content":"那我们该怎么办呢？"},{"from":520.802,"to":522.501,"location":0,"content":"我们可以把内存划分成若干块，"},{"from":522.881,"to":525.203,"location":0,"content":"这些块被称为“页”，因此叫做“页表”，"},{"from":525.663,"to":529.183,"location":0,"content":"并且我们映射的是内存页，而不是每一个单独的字。"},{"from":530.183,"to":536.828,"location":0,"content":"例如，虚拟地址0到4095会被映射到某些物理地址，"},{"from":536.828,"to":541.405,"location":0,"content":"比如16384到20479。"},{"from":542.022,"to":545.503,"location":0,"content":"这意味着我们不再需要为每个字都分配一个页表项。"},{"from":546.123,"to":549.083,"location":0,"content":"相反，我们只需要每4千字节分配一个页表项，"},{"from":549.363,"to":551.264,"location":0,"content":"也就是1024个字。"},{"from":552.264,"to":555.045,"location":0,"content":"页表项的大小不一定是4千字节，"},{"from":555.245,"to":555.985,"location":0,"content":"但这很常见。"},{"from":556.525,"to":558.665,"location":0,"content":"我的Linux电脑使用4千字节的页面，"},{"from":558.845,"to":560.866,"location":0,"content":"但也可以使用其他页面大小。"},{"from":561.526,"to":564.987,"location":0,"content":"使用4千字节页面时，每个页表大约有一百万个条目。"},{"from":565.647,"to":567.787,"location":0,"content":"每个条目的大小仍然是4字节，"},{"from":568.007,"to":570.108,"location":0,"content":"所以每个页表需要4兆字节的空间，"},{"from":570.108,"to":571.888,"location":0,"content":"这是可以接受的。"},{"from":571.888,"to":573.149,"location":0,"content":"不过这里有一个权衡。"},{"from":573.749,"to":576.29,"location":0,"content":"我们不再是一次只从内存中移动一个字，"},{"from":576.69,"to":578.811,"location":0,"content":"而是一次要移动4千字节的数据。"},{"from":579.431,"to":584.873,"location":0,"content":"但实际上这样做效果很好，因为相邻的内存位置通常会被同时访问。"},{"from":586.274,"to":587.914,"location":0,"content":"那么我们该如何映射页面呢？"},{"from":588.655,"to":594.057,"location":0,"content":"以前，我们是对每个单独的字进行映射，转换过程只是在页表中查找。"},{"from":594.697,"to":600.144,"location":0,"content":"现在，页表告诉我们一段虚拟地址范围被映射到一段物理地址范围。"},{"from":600.144,"to":605.081,"location":0,"content":"第0页覆盖的范围是0到4095，依此类推。"},{"from":605.721,"to":607.582,"location":0,"content":"物理空间也是同样的划分方式。"},{"from":608.343,"to":611.764,"location":0,"content":"假设虚拟第1页被映射到物理第2页。"},{"from":612.444,"to":616.326,"location":0,"content":"比如说，虚拟地址4200对应的物理地址是多少？"},{"from":617.326,"to":626.65,"location":0,"content":"答案是8296，因为虚拟页中的每个地址都用相同的偏移量映射到物理地址。"},{"from":627.37,"to":631.792,"location":0,"content":"地址4200距离虚拟页的起始地址有104的偏移，"},{"from":632.572,"to":636.394,"location":0,"content":"所以我们知道它在物理页中也会有相同的偏移量，"},{"from":636.694,"to":641.156,"location":0,"content":"而物理页的起始地址是8192。"},{"from":641.156,"to":643.817,"location":0,"content":"让我们看看地址转换在比特级别是如何实现的。"},{"from":644.497,"to":647.158,"location":0,"content":"假设我们有32位的虚拟地址空间，"},{"from":647.158,"to":650.499,"location":0,"content":"物理地址是30位，也就是1GB的内存，"},{"from":651.04,"to":653.821,"location":0,"content":"页面大小为4KB，也就是12位。"},{"from":655.041,"to":657.362,"location":0,"content":"要将虚拟地址转换为物理地址，"},{"from":657.702,"to":658.523,"location":0,"content":"我们保留偏移量。"},{"from":658.903,"to":661.744,"location":0,"content":"虚拟地址和物理地址的最后12位是相同的。"},{"from":662.744,"to":665.125,"location":0,"content":"要映射虚拟地址剩下的20位，"},{"from":665.766,"to":670.207,"location":0,"content":"CPU会查询页表，获得物理地址剩下的18位。"},{"from":671.188,"to":674.709,"location":0,"content":"去掉偏移量后的虚拟地址部分称为虚拟页号，"},{"from":675.089,"to":678.931,"location":0,"content":"去掉偏移量后的物理地址部分称为物理页号。"},{"from":679.571,"to":682.372,"location":0,"content":"页表负责将虚拟页号映射到物理页号。"},{"from":683.393,"to":684.473,"location":0,"content":"我们来看一个例子。"},{"from":685.133,"to":687.477,"location":0,"content":"假设我们要转换一个虚拟地址，"},{"from":687.477,"to":692.776,"location":0,"content":"比如12345678，最后12位保持不变，"},{"from":692.896,"to":694.537,"location":0,"content":"也就是678。"},{"from":694.537,"to":696.458,"location":0,"content":"所以我们直接把这部分复制到物理地址中。"},{"from":697.338,"to":701.48,"location":0,"content":"然后我们在页表中查找虚拟页号12345，"},{"from":701.88,"to":706.062,"location":0,"content":"查到的物理页号是04321。"},{"from":706.062,"to":710.283,"location":0,"content":"要得到完整的物理地址，只需将物理页号和偏移量拼接起来即可。"},{"from":712.864,"to":714.545,"location":0,"content":"现在我们来讲一下缺页异常。"},{"from":715.446,"to":719.887,"location":0,"content":"我们已经提到过，当数据在内存中，程序尝试访问时会发生什么。"},{"from":721.108,"to":723.009,"location":0,"content":"页表条目会指示数据的位置，"},{"from":723.309,"to":724.549,"location":0,"content":"比如说，数据在硬盘上。"},{"from":725.529,"to":727.43,"location":0,"content":"但这到底是如何运作的呢？"},{"from":728.131,"to":730.271,"location":0,"content":"当 CPU 尝试读取某个虚拟地址时，"},{"from":730.772,"to":732.552,"location":0,"content":"它会在页表中查找地址映射关系。"},{"from":732.933,"to":735.113,"location":0,"content":"如果页表显示数据在磁盘上，"},{"from":735.614,"to":737.674,"location":0,"content":"那么 CPU 就无法从内存中读取该数据。"},{"from":738.395,"to":742.456,"location":0,"content":"此时，CPU 会触发一个异常，这个异常就叫做缺页异常。"},{"from":743.817,"to":747.958,"location":0,"content":"操作系统会处理缺页异常，选择要从内存中移除的页面，"},{"from":748.399,"to":750.508,"location":0,"content":"通常会选择最近最少使用的页面。"},{"from":750.508,"to":753.98,"location":0,"content":"如果该页面被修改过，操作系统会将其写回磁盘。"},{"from":755.381,"to":760.062,"location":0,"content":"如果程序在从磁盘加载页面后对其进行了写入，我们就称该页面为“脏页”。"},{"from":761.182,"to":763.362,"location":0,"content":"如果程序没有对页面进行任何写入，"},{"from":763.702,"to":767.443,"location":0,"content":"那么就不需要保存到磁盘，因为内容没有发生变化。"},{"from":767.883,"to":769.584,"location":0,"content":"这样可以提升一些性能。"},{"from":770.524,"to":773.884,"location":0,"content":"之后，操作系统会将所需页面从磁盘加载到内存中，"},{"from":774.304,"to":778.965,"location":0,"content":"更新页表，然后继续执行引发缺页异常的那条指令。"},{"from":779.686,"to":782.998,"location":0,"content":"这一次，数据已经在内存中了，CPU 就可以访问它了。"},{"from":783.958,"to":785.719,"location":0,"content":"缺页异常的速度非常非常慢。"},{"from":786.199,"to":790.9,"location":0,"content":"当发生缺页异常时，操作系统通常会切换去执行其他程序。"},{"from":791.5,"to":796.541,"location":0,"content":"由于磁盘 IO 非常慢，现代 CPU 架构中有一种叫做 DMA 的模块，"},{"from":796.821,"to":798.941,"location":0,"content":"DMA 的意思是“直接内存访问”。"},{"from":799.982,"to":804.743,"location":0,"content":"DMA 可以在 CPU 执行其他任务时，直接将数据从磁盘加载到内存。"},{"from":807.023,"to":808.683,"location":0,"content":"我们来总结一下到目前为止学到的内容。"},{"from":809.664,"to":812.024,"location":0,"content":"每个程序都有自己的虚拟内存空间。"},{"from":812.664,"to":814.945,"location":0,"content":"说到物理内存，我们指的是 RAM（随机存取存储器）。"},{"from":815.866,"to":820.568,"location":0,"content":"虚拟内存和物理内存都被划分为 4KB 的块，称为页面。"},{"from":821.368,"to":825.089,"location":0,"content":"物理地址和虚拟地址的最后 12 位称为偏移量，"},{"from":825.429,"to":828.631,"location":0,"content":"剩下的位则称为虚拟页号和物理页号。"},{"from":829.051,"to":830.912,"location":0,"content":"这里假设页面大小为 4KB。"},{"from":831.632,"to":835.614,"location":0,"content":"页表负责将虚拟页号映射到物理页号，不包括偏移量。"},{"from":836.374,"to":838.155,"location":0,"content":"每个程序都有自己的页表。"},{"from":838.715,"to":841.116,"location":0,"content":"缺页异常是 CPU 产生的一种异常，"},{"from":841.116,"to":844.457,"location":0,"content":"当它试图访问不在物理内存中的页面时就会发生。"},{"from":845.257,"to":846.898,"location":0,"content":"如果你觉得这个视频内容不错，"},{"from":847.518,"to":850.419,"location":0,"content":"欢迎订阅并分享给你的朋友。"},{"from":850.9,"to":851.6,"location":0,"content":"我们继续吧。"},{"from":853.421,"to":855.662,"location":0,"content":"我希望你现在明白虚拟内存为什么如此有用了，"},{"from":856.042,"to":857.642,"location":0,"content":"但这种间接访问不会很慢吗？"},{"from":858.483,"to":862.484,"location":0,"content":"每次访问内存时，我们都需要在页表中查找页面映射，"},{"from":862.604,"to":865.586,"location":0,"content":"而页表存储在内存中，所以这又需要一次内存访问，"},{"from":865.946,"to":869.687,"location":0,"content":"先进行地址转换，然后再从内存中访问实际数据。"},{"from":870.067,"to":872.528,"location":0,"content":"这样仅仅一次内存访问看起来就非常昂贵。"},{"from":872.909,"to":874.549,"location":0,"content":"你说得对，确实很昂贵。"},{"from":875.189,"to":877.49,"location":0,"content":"我们需要一种能非常快地找到物理地址的方法。"},{"from":878.091,"to":881.352,"location":0,"content":"我们可以在 CPU 中增加一个特殊的硬件组件，"},{"from":881.592,"to":884.353,"location":0,"content":"用来缓存虚拟地址到物理地址的映射。"},{"from":884.993,"to":887.554,"location":0,"content":"这个组件叫做快表（Translation Look Aside Buffer），"},{"from":887.774,"to":888.915,"location":0,"content":"简称 TLB。"},{"from":889.915,"to":892.196,"location":0,"content":"这个缓存很小，但速度非常快。"},{"from":892.997,"to":895.378,"location":0,"content":"当 CPU 需要转换虚拟地址时，"},{"from":895.738,"to":896.738,"location":0,"content":"它会先查询 TLB。"},{"from":897.438,"to":900.299,"location":0,"content":"如果映射在 TLB 里，就会非常快，"},{"from":900.299,"to":901.52,"location":0,"content":"通常只需不到一个时钟周期。"},{"from":902.28,"to":905.461,"location":0,"content":"如果没有，就需要从页表加载到 TLB，"},{"from":905.861,"to":906.361,"location":0,"content":"这个过程就比较慢了。"},{"from":907.121,"to":909.702,"location":0,"content":"现代 CPU 架构通常有两个 TLB，"},{"from":910.102,"to":911.862,"location":0,"content":"一个用于指令，一个用于数据。"},{"from":912.602,"to":916.883,"location":0,"content":"TLB 很小，在现代架构中大约有 4000 项。"},{"from":917.883,"to":920.444,"location":0,"content":"这也是 TLB 经常被更新的原因。"},{"from":921.364,"to":924.885,"location":0,"content":"幸运的是，由于数据的局部性，这种方式在实际中效果很好。"},{"from":925.905,"to":928.685,"location":0,"content":"我们还能做些什么来进一步提升 TLB 的性能呢？"},{"from":929.306,"to":931.486,"location":0,"content":"我们可以增加更多的硬件。"},{"from":931.986,"to":934.587,"location":0,"content":"CPU 通常有两级 TLB 缓存，"},{"from":935.007,"to":936.827,"location":0,"content":"这样可以减少访问内存的次数。"},{"from":937.387,"to":940.608,"location":0,"content":"另一个常见做法是使用类似 DMA 的模块，"},{"from":940.728,"to":944.489,"location":0,"content":"可以直接从内存加载页面到 TLB，而无需回到操作系统。"},{"from":946.009,"to":946.909,"location":0,"content":"我们来看一个例子。"},{"from":947.569,"to":952.47,"location":0,"content":"CPU 想要转换一个虚拟地址 12345678。"},{"from":952.47,"to":954.931,"location":0,"content":"和之前一样，页偏移是相同的，"},{"from":955.131,"to":957.551,"location":0,"content":"所以只需将最后 12 位复制到物理地址中。"},{"from":958.271,"to":964.012,"location":0,"content":"虚拟页号是 12345，通过在 TLB 中查找映射来转换。"},{"from":964.953,"to":967.793,"location":0,"content":"TLB 是空的，因此页面需要从内存中加载。"},{"from":968.573,"to":972.594,"location":0,"content":"我们在程序的页表中定位虚拟页 12345，"},{"from":973.094,"to":975.035,"location":0,"content":"将物理页号填入 TLB，"},{"from":975.655,"to":977.315,"location":0,"content":"这样就可以完成地址转换了。"},{"from":977.995,"to":981.676,"location":0,"content":"下次程序访问相同页号的虚拟地址时，"},{"from":982.056,"to":983.856,"location":0,"content":"会直接从 TLB 中加载。"},{"from":985.157,"to":988.877,"location":0,"content":"如果 TLB 已满且没有该虚拟页号会发生什么？"},{"from":989.497,"to":991.838,"location":0,"content":"我们会移除最近最少使用的条目，"},{"from":992.138,"to":994.639,"location":0,"content":"然后像之前一样加载对应的页面。"},{"from":995.419,"to":997.719,"location":0,"content":"如果程序要访问一个在磁盘上的页面，"},{"from":998.359,"to":1001.68,"location":0,"content":"它仍然会被加载到 TLB，CPU 会产生缺页异常。"},{"from":1002.6,"to":1006.161,"location":0,"content":"实际上，负责地址转换的硬件，"},{"from":1006.201,"to":1008.341,"location":0,"content":"以及产生缺页异常的硬件叫做 MMU，"},{"from":1008.661,"to":1010.342,"location":0,"content":"即内存管理单元。"},{"from":1011.282,"to":1015.583,"location":0,"content":"内存管理单元通常在 CPU 板上，由操作系统进行编程。"},{"from":1018.223,"to":1021.787,"location":0,"content":"这一切看起来都很棒，但我们需要多少内存来运行，"},{"from":1021.787,"to":1022.764,"location":0,"content":"比如说，50个程序呢？"},{"from":1023.465,"to":1025.704,"location":0,"content":"每个程序需要4MB内存，"},{"from":1026.185,"to":1027.486,"location":0,"content":"所以总共需要200MB。"},{"from":1028.507,"to":1030.968,"location":0,"content":"现代计算机会同时运行许多程序。"},{"from":1031.407,"to":1036.349,"location":0,"content":"比如，我的 Linux 电脑现在后台就运行着595个程序，"},{"from":1036.829,"to":1039.55,"location":0,"content":"光是页表就需要超过2GB的内存，"},{"from":1039.83,"to":1043.192,"location":0,"content":"即使这些程序本身并不需要太多内存。"},{"from":1043.853,"to":1045.053,"location":0,"content":"这会浪费大量内存。"},{"from":1045.873,"to":1048.795,"location":0,"content":"难点在于我们不能把页表换到磁盘上，"},{"from":1049.155,"to":1053.096,"location":0,"content":"因为CPU需要页表来把虚拟地址转换为物理地址。"},{"from":1053.837,"to":1056.258,"location":0,"content":"如果页表不在内存里，我们就找不到它。"},{"from":1056.917,"to":1060.019,"location":0,"content":"但我们已经可以把任意内存位置换出到磁盘，"},{"from":1060.459,"to":1062.04,"location":0,"content":"那我们能不能对页面也这样做呢？"},{"from":1062.48,"to":1066.762,"location":0,"content":"为了解决这个问题，我们可以为每个程序引入另一层页表条目。"},{"from":1067.602,"to":1070.242,"location":0,"content":"让我们回到4KB页表的例子。"},{"from":1071.084,"to":1075.965,"location":0,"content":"最后12位用作偏移量，总共有2的20次方个页表条目，"},{"from":1076.445,"to":1077.506,"location":0,"content":"也就是大约一百万个。"},{"from":1078.627,"to":1080.676,"location":0,"content":"如果我们把它们按4KB分块组织，"},{"from":1080.676,"to":1083.489,"location":0,"content":"那就需要1024个块。"},{"from":1084.509,"to":1086.41,"location":0,"content":"这些块就是二级页面。"},{"from":1087.15,"to":1091.752,"location":0,"content":"要把它们换到磁盘上，我们需要一种机制来跟踪它们在内存或磁盘上的位置。"},{"from":1092.752,"to":1095.934,"location":0,"content":"我们可以通过再引入一层页表条目来解决这个问题，"},{"from":1096.253,"to":1097.394,"location":0,"content":"这就是所谓的一级页表。"},{"from":1098.694,"to":1103.136,"location":0,"content":"第一级将虚拟地址转换为第二级页表条目，"},{"from":1103.837,"to":1107.058,"location":0,"content":"而第二级则完成最终到物理地址的转换。"},{"from":1107.838,"to":1109.699,"location":0,"content":"页表可以有超过两级。"},{"from":1110.359,"to":1114.021,"location":0,"content":"增加更多级别会提升复杂性，并且需要更多的内存访问。"},{"from":1114.881,"to":1119.703,"location":0,"content":"Linux 使用五级页表来突破 64TB 物理内存的限制，"},{"from":1120.103,"to":1122.104,"location":0,"content":"目前一些厂商已经为服务器提供了这样的内存容量。"},{"from":1122.964,"to":1127.046,"location":0,"content":"我们来看一个使用多级页表转换虚拟地址的例子。"},{"from":1127.606,"to":1131.628,"location":0,"content":"我们有 32 位的虚拟地址和 30 位的物理地址。"},{"from":1132.488,"to":1134.909,"location":0,"content":"我们将转换之前用过的那个虚拟地址。"},{"from":1135.87,"to":1138.611,"location":0,"content":"第一级页表条目始终存储在内存中。"},{"from":1139.591,"to":1142.092,"location":0,"content":"我们还有一些二级页表条目，"},{"from":1142.352,"to":1144.533,"location":0,"content":"它们也在内存中，但有些可以存放在磁盘上。"},{"from":1145.053,"to":1148.715,"location":0,"content":"对于 4K 页面，最后 12 位用作偏移量，"},{"from":1149.175,"to":1152.336,"location":0,"content":"这和之前一样，所以我们直接将它们复制到物理地址中。"},{"from":1153.297,"to":1155.697,"location":0,"content":"现在我们来看如何转换虚拟页号。"},{"from":1156.438,"to":1158.099,"location":0,"content":"我们会把它分成两部分。"},{"from":1158.599,"to":1159.819,"location":0,"content":"每部分都是 10 位。"},{"from":1160.78,"to":1164.261,"location":0,"content":"我们用前 10 位查找第一级页表条目。"},{"from":1165.021,"to":1168.683,"location":0,"content":"这告诉我们需要进一步查找二级页表条目，"},{"from":1169.023,"to":1171.824,"location":0,"content":"它们存储在地址 0010 处。"},{"from":1173.064,"to":1175.565,"location":0,"content":"我们从内存中获取二级页表条目，"},{"from":1176.285,"to":1180.646,"location":0,"content":"再用另外 10 位找到具体条目，完成最终转换。"},{"from":1183.166,"to":1185.847,"location":0,"content":"虽然第一级页表必须始终保留在内存中，"},{"from":1186.167,"to":1189.928,"location":0,"content":"但二级页表条目可以换出到磁盘以节省内存。"},{"from":1190.548,"to":1193.508,"location":0,"content":"这对那些不怎么用内存的程序尤其有用，"},{"from":1193.928,"to":1196.549,"location":0,"content":"它们也不需要访问完整的虚拟地址空间。"},{"from":1198.869,"to":1201.79,"location":0,"content":"关于虚拟内存，我准备的内容就这些了。"},{"from":1201.854,"to":1204.278,"location":0,"content":"如果你喜欢这个视频，请点个赞，"},{"from":1204.519,"to":1206.362,"location":0,"content":"订阅并分享给你的朋友。"},{"from":1206.903,"to":1210.55,"location":0,"content":"我们下期再见。"}]}